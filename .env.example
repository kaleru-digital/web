# URL pública del sitio (para SEO, sitemap y Open Graph)
NEXT_PUBLIC_SITE_URL=https://kaleru.digital

# Formulario de contacto (opcional). Sin estas variables, el formulario
# muestra el email de contacto como alternativa.
# Clave de https://resend.com (gratuito hasta cierto volumen)
RESEND_API_KEY=
# Dirección que recibe las solicitudes
CONTACT_TO_EMAIL=
# Remitente verificado en Resend (p. ej. "KALERU <web@kaleru.digital>")
CONTACT_FROM_EMAIL=
